# Copia este archivo como .env.local y rellena los valores. Nunca subas valores reales al repositorio.
# En desarrollo todas las claves de servicios externos son opcionales (modo desarrollo).
# En producción (NODE_ENV=production) todas son obligatorias, salvo TRANSFER_LINK_TTL_DAYS, PENDING_CONTRACT_TTL_DAYS
# y PLAN_DELIVERY_REMINDER_BUSINESS_DAYS, que tienen valor por defecto.
# Ver SDD §9.1 y src/lib/config.ts.

# PostgreSQL (Neon). Ej.: postgresql://usuario:password@host.neon.tech/db?sslmode=verify-full
# Usa sslmode=verify-full (verifica el certificado del servidor). Neon entrega la cadena con
# sslmode=require, que el driver `pg` hoy trata igual pero avisa que en su próxima versión será más débil.
# Sin ella en desarrollo, la landing usa el catálogo de src/content/programs.ts (DECISIONS A14).
DATABASE_URL=

# Stripe (sk_..., whsec_..., pk_...). Fuera de producción, usa las claves del modo de prueba (sk_test_…).
# Sin STRIPE_SECRET_KEY en desarrollo, el pago con tarjeta aparece como no disponible.
# Después de definirla: `npm run stripe:sync` (crea los productos y precios y guarda sus IDs en la BD).
# STRIPE_WEBHOOK_SECRET: en local, el que imprime `stripe listen`; en Vercel, el del endpoint del Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend. Sin RESEND_API_KEY en desarrollo, los correos se registran en consola.
RESEND_API_KEY=
# Ej.: THE HYBRID METHOD <hola@tudominio.com>
RESEND_FROM_EMAIL=
FERRO_NOTIFICATION_EMAIL=
# Formato internacional, solo dígitos, sin "+" (formato de wa.me). Ej.: 5215512345678
FERRO_WHATSAPP_NUMBER=

# URL pública de la app, sin "/" final. En desarrollo: http://localhost:3000 por defecto.
APP_URL=
# Hash bcrypt del PIN de aprobación de Ferro (DECISIONS A7, A23). Se genera con `npm run hash-pin`.
# En este archivo los "$" van escapados (\$2b\$12\$…), porque Next.js expande "$" en los .env.
# En Vercel se pega el hash sin escapar.
FERRO_APPROVAL_PIN_HASH=
# Secreto para firmar la cookie de sesión de verificación OTP (DECISIONS A4). Mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
OTP_SESSION_SECRET=
# Vigencia en días del enlace de confirmación de transferencia y del botón de entrega del plan (1–30).
TRANSFER_LINK_TTL_DAYS=7
# Días sin actividad tras los que vence un contrato pendiente (DECISIONS A20).
PENDING_CONTRACT_TTL_DAYS=7
# Días hábiles después del pago en que empiezan los recordatorios de entrega del plan (DECISIONS A19).
PLAN_DELIVERY_REMINDER_BUSINESS_DAYS=1
# Secreto que Vercel Cron envía a /api/cron/daily (mínimo 16 caracteres). Generar con: openssl rand -base64 32
CRON_SECRET=

# ─── Solo desarrollo / CI (no las usa la app) ───────────────────────────────
# BD para las pruebas *.db.test.ts. SE BORRA en cada ejecución; su nombre debe contener "test".
TEST_DATABASE_URL=
# BD auxiliar para `prisma migrate diff --from-migrations` (la CI comprueba las migraciones).
SHADOW_DATABASE_URL=
