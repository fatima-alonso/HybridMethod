// Esquema de datos de THE HYBRID METHOD (SDD §5, DECISIONS A1–A3, A7, A14, A18–A20).
//
// - Dinero siempre en Decimal(10, 2), nunca float.
// - Los cambios de estado de Contract, Payment y Subscription solo ocurren en `src/services/`.
// - Restricciones adicionales que Prisma no expresa (CHECK, secuencia de referencias) están en
//   las migraciones `prisma/migrations/*/migration.sql`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

/// Estados del contrato (DECISIONS A3: no existe `paid`; A20: `expired` y `scheduled`).
enum ContractStatus {
  pending_payment
  expired
  scheduled
  active
  completed
  payment_failed
  cancelled
}

enum PaymentType {
  transfer
  one_time
  subscription
}

enum PaymentMethod {
  transfer
  stripe_one_time
  stripe_subscription
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum SubscriptionStatus {
  incomplete
  active
  past_due
  canceled
  unpaid
}

enum WebhookEventStatus {
  received
  processed
  failed
  ignored
}

// ─── Entidades ──────────────────────────────────────────────────────────────

/// Cliente. Sin campo `country` (DECISIONS A1).
model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  fullName         String
  /// Normalizado: minúsculas y sin espacios (CHECK en la migración).
  email            String   @unique
  /// En E.164, p. ej. +525512345678 (DECISIONS A15; CHECK en la migración).
  whatsapp         String
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contracts        Contract[]
  subscriptions    Subscription[]
  otpVerifications OTPVerification[]

  @@map("customers")
}

/// Programa. Precio completo y precio con suscripción (−10 %, DECISIONS A18).
model Program {
  id                     String   @id @default(uuid()) @db.Uuid
  slug                   String   @unique
  name                   String
  description            String
  /// Precio mensual completo (pago único y transferencia).
  monthlyPrice           Decimal  @db.Decimal(10, 2)
  /// Precio mensual con suscripción: `monthlyPrice` − 10 %, ya redondeado (DECISIONS A18).
  subscriptionPrice      Decimal  @db.Decimal(10, 2)
  currency               String   @default("MXN") @db.Char(3)
  /// Price de Stripe `one_time` (Fase 5). Vale `monthlyPrice`.
  stripePriceIdOneTime   String?  @unique
  /// Price de Stripe `recurring` mensual (Fase 6). Vale `subscriptionPrice`.
  stripePriceIdRecurring String?  @unique
  active                 Boolean  @default(true)
  /// Orden en la landing (DECISIONS A14).
  displayOrder           Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  contracts      Contract[]
  subscriptions  Subscription[]
  servicePeriods ServicePeriod[]

  @@map("programs")
}

/// Contratación. N:1 con Program (DECISIONS A2).
model Contract {
  id                      String         @id @default(uuid()) @db.Uuid
  /// `HM-AAAA-NNNNNN`, generada con la secuencia `contract_reference_seq`.
  reference               String         @unique
  customerId              String         @db.Uuid
  programId               String         @db.Uuid
  paymentType             PaymentType
  status                  ContractStatus @default(pending_payment)
  /// Importe de la modalidad: `Program.monthlyPrice` o `subscriptionPrice` (DECISIONS A18).
  amount                  Decimal        @db.Decimal(10, 2)
  currency                String         @db.Char(3)
  stripeCheckoutSessionId String?        @unique
  serviceStartDate        DateTime?
  serviceEndDate          DateTime?
  /// Última actividad mientras está pendiente; a los 7 días sin actividad vence (DECISIONS A20).
  lastActivityAt          DateTime       @default(now())
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  program           Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  payments          Payment[]
  servicePeriods    ServicePeriod[]
  subscription      Subscription?
  transferApprovals TransferApproval[]

  @@index([customerId])
  @@index([programId])
  @@index([status, serviceEndDate])
  @@map("contracts")
}

/// Cada transacción. Los registros nunca se sobrescriben en una renovación.
model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  contractId            String        @db.Uuid
  subscriptionId        String?       @db.Uuid
  method                PaymentMethod
  stripePaymentIntentId String?       @unique
  stripeInvoiceId       String?       @unique
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @db.Char(3)
  status                PaymentStatus @default(pending)
  paidAt                DateTime?
  createdAt             DateTime      @default(now())

  contract      Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  servicePeriod ServicePeriod?

  @@index([contractId])
  @@index([subscriptionId])
  @@map("payments")
}

/// Un mes pagado (DECISIONS A19): fecha de pago, inicio y fin, y la fecha de entrega del plan, que
/// es solo referencia y no cambia ningún estado.
model ServicePeriod {
  id                 String    @id @default(uuid()) @db.Uuid
  contractId         String    @db.Uuid
  paymentId          String    @unique @db.Uuid
  /// Programa de ese mes (en suscripciones puede cambiar desde el portal).
  programId          String    @db.Uuid
  /// Número de mes dentro del contrato (1, 2, …).
  sequence           Int
  paidAt             DateTime
  startDate          DateTime
  endDate            DateTime
  /// Día de entrega del plan, registrado por Ferro (solo referencia).
  planDeliveredOn    DateTime? @db.Date
  deliveryRecordedAt DateTime?
  lastReminderAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  contract      Contract           @relation(fields: [contractId], references: [id], onDelete: Restrict)
  payment       Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  program       Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  deliveryLinks PlanDeliveryLink[]

  @@unique([contractId, sequence])
  @@index([programId])
  @@index([planDeliveredOn, paidAt])
  @@map("service_periods")
}

/// Copia local del estado de la suscripción en Stripe (sincronizada por webhooks).
model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  customerId           String             @db.Uuid
  programId            String             @db.Uuid
  contractId           String             @unique @db.Uuid
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  program  Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  contract Contract  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([customerId])
  @@index([programId])
  @@map("subscriptions")
}

/// Enlace privado para que Ferro confirme una transferencia (DECISIONS A7).
/// Válido solo si `usedAt` e `invalidatedAt` son nulos, `expiresAt > now` y `pinAttempts < 5`.
model TransferApproval {
  id            String    @id @default(uuid()) @db.Uuid
  contractId    String    @db.Uuid
  /// SHA-256 del token; el token en claro nunca se guarda.
  tokenHash     String    @unique
  expiresAt     DateTime
  pinAttempts   Int       @default(0)
  usedAt        DateTime?
  invalidatedAt DateTime?
  approvedBy    String?
  createdAt     DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@map("transfer_approvals")
}

/// Botón "Registrar entrega del plan" (DECISIONS A19): uno en el correo de compra y uno por
/// recordatorio. Válido si `expiresAt > now` y su mes no tiene `planDeliveredOn`. Sin PIN.
model PlanDeliveryLink {
  id              String    @id @default(uuid()) @db.Uuid
  servicePeriodId String    @db.Uuid
  /// SHA-256 del token; el token en claro nunca se guarda.
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  servicePeriod ServicePeriod @relation(fields: [servicePeriodId], references: [id], onDelete: Restrict)

  @@index([servicePeriodId])
  @@map("plan_delivery_links")
}

/// Código OTP de verificación de correo (DECISIONS A4). Solo se guarda el hash.
model OTPVerification {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String?   @db.Uuid
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@map("otp_verifications")
}

/// Eventos de Stripe recibidos. `stripeEventId` UNIQUE garantiza la idempotencia (RN-11).
model WebhookEvent {
  id            String             @id @default(uuid()) @db.Uuid
  stripeEventId String             @unique
  eventType     String
  status        WebhookEventStatus @default(received)
  error         String?
  processedAt   DateTime?
  createdAt     DateTime           @default(now())

  @@map("webhook_events")
}

/// Operaciones sensibles (SRS §10). Nunca contiene códigos, tokens ni PIN (SDD §9.6).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  action     String
  actor      String
  entityType String
  entityId   String
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Contadores de rate limit por ventana fija (DECISIONS A16). Se guardan en la BD porque en
/// Vercel cada instancia tiene su propia memoria. `key` = "<alcance>:<SHA-256 del identificador>":
/// nunca se guarda la IP ni el correo en claro.
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
  @@map("rate_limit_buckets")
}
